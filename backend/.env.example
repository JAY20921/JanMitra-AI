PROJECT_NAME="AI Citizen Assistant"
VERSION="0.1.0"
API_V1_STR="/api/v1"

# Environment
ENVIRONMENT="development" # development, staging, production
CORS_ORIGINS="*" # comma separated string of origins, e.g. "http://localhost:3000,https://my-domain.com"

# Vector Database (Qdrant)
QDRANT_URL="http://localhost:6333"
QDRANT_API_KEY="" # Leave empty for local development

# LLM Providers
OPENAI_API_KEY="sk-..."
GEMINI_API_KEY="AIza..."
GROQ_API_KEY="gsk_..."
OLLAMA_BASE_URL="http://localhost:11434"

# Live Web Search
TAVILY_API_KEY="tvly-..."

# Embedding Model (Jina Embeddings v3 — cloud-hosted multilingual, 94 languages)
EMBEDDING_MODEL_NAME="jina-embeddings-v3"
JINA_API_KEY="jina_..."
